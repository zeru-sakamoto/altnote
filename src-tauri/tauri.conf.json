{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AltNote",
  "version": "1.2.0",
  "identifier": "com.altnote.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "txt",
          "md",
          "markdown",
          "log",
          "json",
          "yaml",
          "yml",
          "js",
          "ts",
          "tsx",
          "jsx",
          "css",
          "html",
          "py",
          "blk",
          "ini",
          "cfg",
          "conf",
          "toml",
          "xml"
        ],
        "name": "Text Document",
        "description": "AltNote-editable text file",
        "role": "Editor"
      }
    ]
  }
}
